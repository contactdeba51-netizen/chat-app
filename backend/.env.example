PORT=5000
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/chat_app
DATABASE_SSL=false
JWT_SECRET=replace-with-a-long-random-secret
# Optional but recommended: a separate secret for media links.
# MEDIA_SECRET=another-long-random-secret
# Comma-separated extra browser origins (the CLIENT_URL is always allowed).
# ALLOWED_ORIGINS=https://app.example.com

# Email verification and password recovery (required for new sign-ups).
# Brevo is the free primary sender (~300 emails/day, verify the sender address once).
BREVO_API_KEY=
EMAIL_FROM=your-verified-sender@gmail.com
EMAIL_FROM_NAME=Chat App

# Optional fallback sender. Only needed if you prefer Resend over Brevo.
RESEND_API_KEY=

# Optional rate-limit overrides (attempts per window, per IP).
LOGIN_RATE_LIMIT=30
CODE_RATE_LIMIT=20

# --- Managed PostgreSQL (production) ----------------------------------------
# Neon: runtime uses the pooled host (contains "-pooler"), migrations and
# backups use the direct host because advisory locks need a session connection.
# DIRECT_DATABASE_URL=postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/chat_app?sslmode=require
# DATABASE_SSL=true

# --- Media storage -----------------------------------------------------------
# local = backend/uploads (development only; Render's disk is ephemeral).
# s3    = private S3-compatible bucket (Neon Object Storage, Backblaze B2, R2).
# r2    = legacy Cloudflare R2 driver, kept for existing deployments.
MEDIA_DRIVER=local
# During a migration set MEDIA_FALLBACK=local to mirror new uploads to disk.
MEDIA_FALLBACK=none
# Chat-facing link lifetime (7 days), presigned redirect lifetime, and the
# object URL lifetime used for browser caching (SigV4 caps this at 7 days).
MEDIA_URL_TTL_SECONDS=604800
MEDIA_REDIRECT_TTL_SECONDS=300
MEDIA_SIGNED_URL_TTL_SECONDS=604800
# Object response header. Keys are immutable, so a long lifetime is safe.
# MEDIA_CACHE_CONTROL=private, max-age=604800, immutable
# Key prefix inside the bucket, so one bucket can hold prod/ and backups/.
MEDIA_PREFIX=prod
# Quotas, per account: 1 GB total, 100 MB/day, 1000 objects.
MEDIA_ACCOUNT_QUOTA_BYTES=1073741824
MEDIA_DAILY_QUOTA_BYTES=104857600
MEDIA_MAX_OBJECTS=1000
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_DIMENSION=4096
# Optional per-account/hour and per-IP/hour upload budgets.
# UPLOAD_RATE_LIMIT=40
# UPLOAD_IP_RATE_LIMIT=120
# PostgreSQL pool size (keep small on free instances).
# PG_POOL_MAX=10

# --- S3-compatible object storage (MEDIA_DRIVER=s3) ---------------------------
# Neon Object Storage: project -> Settings -> Credentials, scopes storage:read
# and storage:write on the production branch. Copy the values as AWS names them.
# Backblaze B2 (fallback): endpoint s3.eu-central-003.backblazeb2.com,
# region eu-central-003, bucket private, key scoped to that one bucket.
# S3_ENDPOINT=https://br-xxxx.storage.c-1.ap-southeast-1.aws.neon.tech
# S3_REGION=ap-southeast-1
# S3_BUCKET=media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Neon and B2 both require path-style addressing.
S3_FORCE_PATH_STYLE=true

# Legacy Cloudflare R2 driver (MEDIA_DRIVER=r2 only).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=chat-app-media-prod
# Render sits behind one proxy; keep this so per-IP limits see real addresses.
TRUST_PROXY_HOPS=1
